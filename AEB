import numpy as np
from sklearn.cluster import DBSCAN
import matplotlib.pyplot as plt

# ────────────────────────────────────────────────
# 1. Synthetic point cloud (same as before)
np.random.seed(42)

vehicle_points    = np.random.normal(loc=[10.0, 0.0], scale=[1.5, 0.6], size=(50, 2))
pedestrian_points = np.random.normal(loc=[25.0, 4.0], scale=[0.5, 1.0], size=(20, 2))
noise_points      = np.random.normal(loc=0.0, scale=15.0, size=(120, 2))

point_cloud = np.vstack([vehicle_points, pedestrian_points, noise_points])

# ────────────────────────────────────────────────
# 2. DBSCAN clustering
eps = 1.8
min_samples = 5

db = DBSCAN(eps=eps, min_samples=min_samples).fit(point_cloud)
labels = db.labels_

# ────────────────────────────────────────────────
# 3. AEB decision parameters
MAX_BRAKE_DISTANCE = 18.0      # meters — brake if any relevant object closer than this
LANE_WIDTH_HALF    = 2.0       # meters — consider |y| ≤ this value as "in ego lane"

# ────────────────────────────────────────────────
# 4. Analyze clusters and decide AEB
unique_labels = set(labels)
aeb_active = 0  # default: no braking

for cluster_id in [lbl for lbl in unique_labels if lbl != -1]:
    mask = (labels == cluster_id)
    cluster_pts = point_cloud[mask]
    
    if len(cluster_pts) < min_samples:
        continue  # too small → probably noise fragment
    
    centroid = np.mean(cluster_pts, axis=0)
    x, y = centroid
    
    # Only consider objects in front and in/near ego lane
    if x <= 0 or abs(y) > LANE_WIDTH_HALF:
        continue
    
    # Distance check (here we use x as proxy for longitudinal distance)
    if x <= MAX_BRAKE_DISTANCE:
        aeb_active = 1
        print(f"→ AEB TRIGGERED by cluster {cluster_id} "
              f"(centroid at x={x:.1f} m, y={y:.1f} m)")
        break  # can break early once we decide to brake

print("\nFinal AEB decision:", aeb_active)
print("  (1 = BRAKE, 0 = no action)")

# ────────────────────────────────────────────────
# Optional: visualization
plt.figure(figsize=(10, 6))
plt.scatter(point_cloud[:, 0], point_cloud[:, 1],
            c=labels, cmap='tab10', s=35, alpha=0.9)
plt.scatter(point_cloud[labels == -1, 0], point_cloud[labels == -1, 1],
            c='black', s=25, label='Noise')

# Draw lane boundaries
plt.axvspan(-100, 100, ymin=0.5-LANE_WIDTH_HALF/20, ymax=0.5+LANE_WIDTH_HALF/20,
            color='yellow', alpha=0.12, label='Ego lane approx.')

plt.axvline(x=MAX_BRAKE_DISTANCE, color='red', linestyle='--', alpha=0.6,
            label=f'Max brake dist ({MAX_BRAKE_DISTANCE} m)')

plt.title('DBSCAN Clustering + Simple AEB Decision')
plt.xlabel('X (meters forward)')
plt.ylabel('Y (meters lateral)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()
